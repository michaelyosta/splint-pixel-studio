{
  "name": "splint-gemini",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "npm --prefix server run dev:local",
    "build": "vite build",
    "catalog:build": "python server/scripts/build-catalog-assets.py",
    "benchmark:pixelization": "node scripts/pixelization-corpus-benchmark.mjs",
    "benchmark:pixelization-memory": "node --expose-gc scripts/benchmark-pixelization-memory.mjs",
    "lint": "node scripts/lint-warning-budget.mjs",
    "lint:raw": "oxlint",
    "test": "node --test \"test/*.test.js\" \"src/lib/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\" \"src/lib/*.test.js\"",
    "test:integration": "node --test server/test/api.integration.test.js",
    "test:server": "npm --prefix server test",
    "test:e2e": "playwright test",
    "qa:specials": "node --env-file=.env.local scripts/check-special-cells-qa.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
