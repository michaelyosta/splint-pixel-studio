# Leave empty to use the file-backed local development database.
# Set this after `docker compose up -d postgres` to run PostgreSQL migrations.
DATABASE_URL=postgresql://splint:splint_dev_password@localhost:5432/splint
PORT=3001
TELEGRAM_BOT_TOKEN=
ALLOW_DEV_AUTH=true
# Dev/test-only Spark QA override: SPECIALS_CONTROL or SPECIALS_TREATMENT.
# Legacy aliases SPARK_CONTROL and SPARK_TREATMENT are accepted too. Leave
# empty to use the unchanged deterministic production assignment. Ignored
# unless ALLOW_DEV_AUTH=true, NODE_ENV is exactly development/test,
# SPECIAL_CELLS_QA_OVERRIDE=true, and SPECIAL_CELLS_QA_USER_ID matches the
# authenticated dev user.
SPECIAL_CELLS_COHORT=
# Explicitly enables the dev/test cohort override for the allowlisted QA user.
SPECIAL_CELLS_QA_OVERRIDE=false
# Narrow allowlist of authenticated dev user ids that may use the override.
SPECIAL_CELLS_QA_USER_ID=
# Opt-in server diagnostics payload in dev/test. Omitted in production and in
# ordinary development responses unless explicitly set to true.
SPECIAL_CELLS_DIAGNOSTICS=false
# Payment mode: disabled (public-alpha default), internal_credits (dev/test
# ledger), or telegram_stars (production only after explicit readiness review).
PAYMENTS_MODE=disabled
# Required when PAYMENTS_MODE=telegram_stars in production.
TELEGRAM_PAYMENTS_WEBHOOK_SECRET=
TELEGRAM_PAYMENT_SUPPORT=
TELEGRAM_PAYMENT_REFUND_CONTACT=
# Optional MinIO / S3-compatible private original-image storage.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=splint-originals
S3_ACCESS_KEY_ID=splint_minio
S3_SECRET_ACCESS_KEY=splint_minio_password
S3_REGION=us-east-1
