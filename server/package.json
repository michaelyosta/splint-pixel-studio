{
  "name": "splint-server",
  "version": "1.0.0",
  "description": "Splint Social Layer — Node.js/Express backend with SQLite",
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dev:local": "node --env-file=../.env.local --watch index.js",
    "start:postgres": "node index.js",
    "dev:postgres": "node --watch index.js",
    "migrate": "node scripts/migrate.js",
    "migrate:postgres": "node scripts/migrate-postgres.js",
    "bootstrap:system": "node bootstrap-system.js",
    "seed:demo": "node seed-demo.js",
    "reset:demo": "node reset-demo.js",
    "check": "node scripts/check.js",
    "backfill:guidance": "node scripts/backfill-tiled-guidance.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:sqlite": "node --test \"test/*.test.js\"",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "restore:postgres": "node scripts/restore-postgres.mjs",
    "inventory:media": "node scripts/inventory-media.mjs",
    "media:sweep": "node scripts/sweep-media.mjs",
    "backup:objects": "node scripts/backup-objects.mjs",
    "verify:object-backup": "node scripts/verify-object-backup.mjs",
    "restore:objects": "node scripts/restore-objects.mjs",
    "storage:init": "node scripts/init-s3-bucket.mjs",
    "test:postgres": "node --test --test-concurrency=1 test/database.test.js test/postgres-database.test.js test/postgres-demo-seed.test.js test/postgres-content-integrity-migration.test.js test/postgres-production-security.test.js test/postgres-security-hardening.test.js test/postgres-stars-transactions.test.js test/postgres-http-stars-transactions.test.js test/postgres-render-outbox.test.js test/postgres-progression.test.js test/postgres-unlocks.test.js test/postgres-abuse-limiter.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "pg": "^8.13.1",
    "sql.js": "^1.12.0",
    "uuid": "^11.0.5"
  }
}
