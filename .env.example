# ═══════════════════════════════════════════════════════════════════════
# SPLINT Development Environment
# ═══════════════════════════════════════════════════════════════════════
#
# Quick start:
#   Copy-Item .env.example .env.local
#
# Then edit .env.local and enable dev auth:
#   ALLOW_DEV_AUTH=true
#   VITE_ALLOW_DEV_AUTH=true
#   SEED_DEMO_DATA=true
#
# Never commit .env.local. It is already in .gitignore.
# VITE_* variables must never contain secrets — they are bundled into the
# client bundle.

# ── Dev Auth ───────────────────────────────────────────────────────────
# Set both to "true" in .env.local to skip Telegram Mini Apps auth.
ALLOW_DEV_AUTH=false
VITE_ALLOW_DEV_AUTH=false
# User ID used by the frontend when dev auth is active.
VITE_DEV_USER_ID=user_pixelhunter
# Dev/test-only manual QA override. Leave empty for deterministic assignment.
# Allowed values: SPECIALS_CONTROL or SPECIALS_TREATMENT. Legacy aliases
# SPARK_CONTROL and SPARK_TREATMENT are also accepted. Ignored in production
# unless ALLOW_DEV_AUTH=true, NODE_ENV is exactly development/test,
# SPECIAL_CELLS_QA_OVERRIDE=true, and SPECIAL_CELLS_QA_USER_ID matches the
# authenticated dev user. Production cohort assignment is unchanged.
SPECIAL_CELLS_COHORT=
# Explicitly enables the dev/test cohort override. Must be paired with a
# disposable SPECIAL_CELLS_QA_USER_ID; it never applies to every dev user.
SPECIAL_CELLS_QA_OVERRIDE=false
# Narrow allowlist of authenticated dev user ids that may use the override.
# Use the same value as VITE_DEV_USER_ID on a disposable QA identity.
SPECIAL_CELLS_QA_USER_ID=
# Opt-in server diagnostics payload in dev/test. Omitted in production and in
# ordinary development responses unless explicitly set to true.
SPECIAL_CELLS_DIAGNOSTICS=false
# Keep the coloring diagnostics overlay hidden unless a developer explicitly enables it.
VITE_SHOW_COLORING_DIAGNOSTICS=false
# Keep the Special Cells diagnostics HUD/state dump hidden unless explicitly enabled.
VITE_SHOW_SPECIAL_CELLS_DIAGNOSTICS=false
# Product Recovery Phase 0/1 core-feel slice. In production the URL gate is
# ignored unless this explicit deployment flag is true.
VITE_CORE_FEEL_EXPERIMENT_ENABLED=false

# ── Demo Data ─────────────────────────────────────────────────────────
SEED_DEMO_DATA=false
ALLOW_DESTRUCTIVE_DB_RESET=false

# ── Server ─────────────────────────────────────────────────────────────
PORT=3001
# Required in production. Comma-separated Mini App origins, without paths.
CORS_ORIGINS=
# Required in production. Explicit proxy IP/CIDR list; hop counts are rejected.
TRUST_PROXY=

# ── Database ───────────────────────────────────────────────────────────
# Leave empty to use SQLite (file-backed, no Docker required).
# Set to postgresql://… after `docker compose up -d postgres`.
DATABASE_URL=
SQLITE_DB_PATH=

# ── Docker Compose — PostgreSQL ────────────────────────────────────────
POSTGRES_USER=splint
POSTGRES_PASSWORD=splint_dev_password
POSTGRES_DB=splint
POSTGRES_PORT=5432

# ── Docker Compose — MinIO (S3-compatible storage) ─────────────────────
MINIO_ROOT_USER=splint_minio
MINIO_ROOT_PASSWORD=splint_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=splint-originals
# Optional S3 credentials for private original-image storage.
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=splint_minio
S3_SECRET_ACCESS_KEY=splint_minio_password
S3_REGION=us-east-1
# Production requires the explicit s3 driver; local development may use local.
STORAGE_DRIVER=local

# ── Payments ──────────────────────────────────────────────────────────
# Public alpha defaults to no external payments. `internal_credits` is a
# development-only ledger mode. `telegram_stars` is not enabled until the
# Telegram webhook/support/refund controls are configured in production.
PAYMENTS_MODE=disabled
# Required only for PAYMENTS_MODE=telegram_stars in production.
TELEGRAM_PAYMENTS_WEBHOOK_SECRET=
TELEGRAM_PAYMENT_SUPPORT=
TELEGRAM_PAYMENT_REFUND_CONTACT=

# ── Telegram (production only) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
